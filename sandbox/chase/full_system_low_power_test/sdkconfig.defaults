# Target & Flash/PSRAM (Hosyond ESP32-S3-WROOM-1 N16R8: 16MB Flash, 8MB Octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Keep Console on UART0 (CH343 USB-UART on COM6) so Monitor output survives Light Sleep
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Power Management (Dynamic Frequency Scaling + Automatic Light Sleep via Tickless Idle)
CONFIG_PM_ENABLE=y
CONFIG_PM_PROFILING=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_HZ=1000

# NimBLE BLE Stack (Compatible with GatorGrasp Companion App)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=64

# Enable BLE Controller Modem Sleep using Main XTAL so BLE connections survive Light Sleep
# without needing an external 32.768 kHz crystal soldered on the dev board
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
